{
  "name": "mathitis",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm -r test:integration",
    "test:e2e": "pnpm -r test:e2e",
    "audit": "pnpm audit --audit-level=high",
    "db:generate": "pnpm --filter @mathitis/api db:generate",
    "db:migrate": "pnpm --filter @mathitis/api db:migrate",
    "db:seed": "pnpm --filter @mathitis/api db:seed",
    "env:dev": "./scripts/dev-up.sh",
    "env:dev:fresh": "./scripts/dev-up.sh --fresh",
    "env:prod": "./scripts/prod-up.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fastify/type-provider-zod": "^1.0.0",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
