{
  "name": "@mathitis/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --root ../.. --no-file-parallelism",
    "test:unit": "vitest run --root ../.. apps/api/tests/unit",
    "test:integration": "vitest run --root ../.. --no-file-parallelism apps/api/tests/integration",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/sensible": "^6.0.1",
    "@fastify/static": "^10.1.3",
    "@mathitis/schemas": "workspace:*",
    "@prisma/client": "^6.0.0",
    "@sentry/node": "^10.70.0",
    "argon2": "^0.41.1",
    "bullmq": "^6.1.2",
    "fastify": "^5.2.0",
    "ioredis": "^6.0.0",
    "jose": "^5.9.6",
    "nanoid": "^5.0.9",
    "nodemailer": "^9.0.5",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "sharp": "^0.35.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@mathitis/tsconfig": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "prisma": "^6.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^2.1.8"
  }
}
