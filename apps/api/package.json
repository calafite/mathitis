{
  "name": "@mathitis/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --root ../.. --no-file-parallelism",
    "test:coverage": "vitest run --root ../.. --no-file-parallelism --coverage",
    "test:unit": "vitest run --root ../.. apps/api/tests/unit",
    "test:integration": "vitest run --root ../.. --no-file-parallelism apps/api/tests/integration",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1119.0",
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/static": "^10.1.3",
    "@huggingface/transformers": "^4.2.0",
    "@mathitis/schemas": "workspace:*",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^10.71.0",
    "argon2": "^0.41.1",
    "bullmq": "^6.3.0",
    "fastify": "^5.12.1",
    "ioredis": "^6.0.0",
    "jose": "^5.10.0",
    "nanoid": "^5.1.16",
    "nodemailer": "^9.0.5",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.35.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@mathitis/tsconfig": "workspace:*",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "prisma": "^6.19.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
