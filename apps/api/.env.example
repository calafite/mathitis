# Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Secrets (min 32 chars each)
JWT_SECRET=dev_only_jwt_secret_change_me_min_32_chars
COOKIE_SECRET=dev_only_cookie_secret_change_me_min_32_chars
SESSION_MAX_AGE_DAYS=7

# Database
DATABASE_URL=postgresql://mathitis_app:app_password@localhost:5432/mathitis

# Redis
REDIS_URL=redis://localhost:6379

# Object storage (MinIO/S3) - optional in development
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=mathitis
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false
# S3_PUBLIC_BASE_URL=https://cdn.mathitis.dev  # overrides generated asset URLs
# PUBLIC_BASE_URL=http://localhost:4000       # used for locally-served uploads
# UPLOAD_DIR=uploads                          # local uploads dir when S3 is unset

# Monitoring
SENTRY_DSN=

# SMTP - optional in development; verification/reset emails are logged
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=mathitis@cs.uni.edu