# Mathitis production environment
# Copy to .env.production and fill in real values.

NODE_ENV=production
HOST=0.0.0.0
PORT=4000

# Secrets - generate with `openssl rand -hex 32` (min 32 chars)
JWT_SECRET=replace-with-32-byte-random
COOKIE_SECRET=replace-with-32-byte-random
SESSION_MAX_AGE_DAYS=7

# PostgreSQL (postgres container + api)
POSTGRES_USER=mathitis
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=mathitis
DATABASE_URL=postgresql://mathitis:replace-with-strong-password@postgres:5432/mathitis

# Redis (redis container + api)
REDIS_PASSWORD=replace-with-strong-password
REDIS_URL=redis://:replace-with-strong-password@redis:6379

# S3 / MinIO object storage
S3_ENDPOINT=http://minio:9000
S3_BUCKET=mathitis
S3_ACCESS_KEY=mathitis
S3_SECRET_KEY=replace-with-minio-secret
S3_USE_SSL=false
S3_PUBLIC_BASE_URL=https://mathitis.university.edu

# Public base URL (used for generated links/redirects)
PUBLIC_BASE_URL=https://mathitis.university.edu
UPLOAD_DIR=uploads

# Sentry (optional)
SENTRY_DSN=

# Logging
LOG_LEVEL=info

# SMTP email (optional - dev no-op logger used when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@mathitis.university.edu

# MinIO server
MINIO_ROOT_USER=mathitis
MINIO_ROOT_PASSWORD=replace-with-minio-secret
