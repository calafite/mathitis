# Mathitis Production Environment Template
# Copy to `.env.production` and replace every placeholder value.
# Secrets MUST be at least 32 characters (JWT_SECRET, COOKIE_SECRET, REDIS_PASSWORD).
#   Generate: openssl rand -base64 48

# --- Application (API) ---
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Secrets (generate fresh values, never reuse development secrets)
JWT_SECRET=replace_with_64_character_random_value
# Legacy verify-only secrets for zero-downtime JWT rotation, comma-separated or JSON array.
# Populate with the PREVIOUS JWT_SECRET value(s) during a rotation (see docs/operations/03-secret-rotation.md).
JWT_KEYRING=
COOKIE_SECRET=replace_with_64_character_random_value
SESSION_MAX_AGE_DAYS=7

# Web origin (public URL users browse on; used for CORS/cookie scoping).
# When unset, same-origin only is allowed in production.
WEB_ORIGIN=https://mathitis.university.edu

# --- Database (PostgreSQL 16) ---
POSTGRES_USER=mathitis_app
POSTGRES_PASSWORD=replace_with_strong_database_password
POSTGRES_DB=mathitis
# Container-internal hostname is `postgres`; port 5432 inside the network.
# The user and password below must match POSTGRES_USER / POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://mathitis_app:replace_with_strong_database_password@postgres:5432/mathitis

# --- Redis 7 ---
REDIS_PASSWORD=replace_with_64_character_random_value
# Password must be embedded in the URL: redis://:<password>@host:6379
# Must match REDIS_PASSWORD above.
REDIS_URL=redis://:replace_with_64_character_random_value@redis:6379

# --- Object storage (MinIO/S3) ---
# MINIO_ROOT_USER must equal S3_ACCESS_KEY, and MINIO_ROOT_PASSWORD must equal S3_SECRET_KEY.
MINIO_ROOT_USER=mathitis_storage
MINIO_ROOT_PASSWORD=replace_with_strong_storage_password
# Container-internal hostname is `minio`; port 9000 inside the network.
S3_ENDPOINT=http://minio:9000
S3_BUCKET=mathitis
S3_ACCESS_KEY=mathitis_storage
S3_SECRET_KEY=replace_with_strong_storage_password
S3_USE_SSL=false
# Public CDN base used in asset URLs (served by nginx at /assets/uploads/):
S3_PUBLIC_BASE_URL=https://mathitis.university.edu/assets/uploads

# Public base URL (used for generated links/redirects and locally-served uploads)
PUBLIC_BASE_URL=https://mathitis.university.edu
UPLOAD_DIR=uploads

# --- Monitoring (optional) ---
SENTRY_DSN=
# Baked into the web bundle at build time (see docker-compose.production.yml):
VITE_SENTRY_DSN=
VITE_RELEASE=v1.0.0

# --- SMTP (email verification & password reset; emails are logged if unset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@mathitis.university.edu

# --- Rate limiting (tune per expected traffic) ---
RATE_LIMIT_GLOBAL_MAX=120
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_REQUEST_MAX=10